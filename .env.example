# Resend sending API key. Server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Field Council <applications@yourdomain.com>
APPLICATIONS_EMAIL_FROM=
# The inbox that receives applications.
APPLICATIONS_EMAIL_TO=mordi@usezaro.com
# Optional canonical URL; otherwise Vercel's production domain is used.
SITE_URL=
