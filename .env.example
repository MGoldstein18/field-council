# PostgreSQL: use a dedicated Neon database (or another PostgreSQL provider).
# In Vercel, connect Neon from Storage/Marketplace to provision DATABASE_URL.
DATABASE_URL=
# Generate both values with npm run admin:setup; never use NEXT_PUBLIC_ prefixes.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional canonical URL, otherwise Vercel's production URL is used.
SITE_URL=
